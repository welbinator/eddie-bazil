---
import Layout from '../layouts/Layout.astro';
import { partners, testimonials } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = testimonials.slice(3);
---
<Layout title="Friends & trusted partners | Eddie Bazil" description="The companies and people Eddie Bazil handpicks and works with, chosen for honesty, professionalism and their contribution to the audio industry.">

  <section class="phead">
    <div class="wrap">
      <p class="eyebrow">Friends</p>
      <h1 class="display">In this industry, trust is everything.</h1>
      <p class="lead">The companies and people below share that mindset. I have handpicked every one of them for honesty, professionalism and their contribution to our ever growing industry, and I work closely with them so my students and subscribers get the best products and services.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="partners rise">
        {partners.map((p) => <div class="partners__cell">{p}</div>)}
      </div>
    </div>
  </section>

  <section class="section section--taupe">
    <div class="wrap">
      <div class="sec-head rise">
        <p class="eyebrow">More kind words</p>
        <h2 class="heading">What students say</h2>
      </div>
      <div class="grid grid-2">
        {rest.map((t) => (
          <figure class="card card--elevated quote rise">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption>
              <span class="quote__name">{t.name}</span>
              <span class="quote__role">{t.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <style>
    .phead { padding: 80px 0 40px; max-width: 820px; }
    .phead .display { margin: 8px 0 20px; }

    .partners { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--stone); border: 1px solid var(--stone); border-radius: var(--radius-large); overflow: hidden; }
    .partners__cell { background: var(--eggshell); display: grid; place-items: center; text-align: center; padding: 38px 20px; font-family: var(--font-display); font-size: 20px; font-weight: 400; letter-spacing: -0.02em; color: var(--graphite); transition: background .2s, color .2s; min-height: 128px; }
    .partners__cell:hover { background: var(--warm-taupe); color: var(--ink); }

    .sec-head { max-width: 560px; margin-bottom: 40px; }
    .sec-head .heading { margin-top: 6px; }
    .quote { display: flex; flex-direction: column; gap: 20px; }
    .quote blockquote { font-size: 17px; line-height: 1.6; color: var(--graphite); }
    .quote figcaption { display: flex; flex-direction: column; gap: 2px; margin-top: auto; }
    .quote__name { font-weight: 500; }
    .quote__role { font-size: 13px; color: var(--ash); }

    @media (max-width: 900px) { .partners { grid-template-columns: repeat(2, 1fr); } }
  </style>
</Layout>
